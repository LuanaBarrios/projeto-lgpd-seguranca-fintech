{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "name": "AuroraPay-Escuro",
  "dataColors": [
    "#22D3EE",
    "#0E7490",
    "#67E8F9",
    "#94A3B8",
    "#155E75",
    "#A5F3FC",
    "#64748B",
    "#0891B2"
  ],
  "foreground": "#FFFFFF",
  "foregroundNeutralSecondary": "#CBD5E1",
  "foregroundNeutralTertiary": "#94A3B8",
  "background": "#12223D",
  "backgroundLight": "#1B2E4F",
  "backgroundNeutral": "#0B1426",
  "tableAccent": "#22D3EE",
  "good": "#27AE60",
  "neutral": "#F1C40F",
  "bad": "#C0392B",
  "maximum": "#22D3EE",
  "center": "#0E7490",
  "minimum": "#12223D",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#CBD5E1"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#12223D"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#22D3EE"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontFamily": "Segoe UI",
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontFamily": "Segoe UI",
            "gridlineColor": {
              "solid": {
                "color": "#1E3A5F"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0B1426"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0B1426"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#1E3A5F"
              }
            },
            "gridHorizontalWeight": 1,
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#1E3A5F"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#22D3EE"
              }
            },
            "backColor": {
              "solid": {
                "color": "#12223D"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#12223D"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#152847"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#12223D"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#1E3A5F"
              }
            },
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#1E3A5F"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#1E3A5F"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#22D3EE"
              }
            },
            "backColor": {
              "solid": {
                "color": "#12223D"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#12223D"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#12223D"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#12223D"
              }
            }
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#12223D"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#22D3EE"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#12223D"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}