/// Eixo de 1 a 5 da matriz de risco (mostra a grade completa, mesmo sem riscos).
table dim_impacto
	lineageTag: ede1e9be-9bcc-4c67-8e15-4f111b616ded

	column Impacto
		dataType: int64
		formatString: 0
		lineageTag: 7f4827a6-7649-44c5-9f00-17f6904d0369
		summarizeBy: none
		isNameInferred
		sourceColumn: [Impacto]

	partition dim_impacto = calculated
		source = SELECTCOLUMNS(GENERATESERIES(1, 5, 1), "Impacto", [Value])

