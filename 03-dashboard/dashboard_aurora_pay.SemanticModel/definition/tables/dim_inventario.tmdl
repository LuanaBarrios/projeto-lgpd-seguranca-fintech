	column 'Base legal (artigo)' =
			VAR t = SUBSTITUTE(TRIM(dim_inventario[base_legal_proposta]), " ", "|")
			RETURN PATHITEM(t, 2) & " " & PATHITEM(t, 3)
		lineageTag: abcafeaa-dee6-41f7-9d17-08bdab3565a3

	partition dim_inventario = m
		mode: import
		source =
				let
				  Origem = Csv.Document(File.Contents(PastaDados & "dim_inventario.csv"), [Delimiter = ",", Columns = 13, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(Origem, [PromoteAllScalars = true])
				in
				  #"Cabeçalhos promovidos"

	annotation PBI_ResultType = Table

