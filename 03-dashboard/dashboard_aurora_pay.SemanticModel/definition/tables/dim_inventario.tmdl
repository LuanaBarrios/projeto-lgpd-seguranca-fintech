table dim_inventario
	lineageTag: eeab91b6-761a-4531-8940-83d9a0ee79c6

	/// Categorias com dado pessoal sensível (art. 5º, II, LGPD).
	measure 'Dados Sensíveis' = CALCULATE(COUNTROWS(dim_inventario), dim_inventario[dado_sensivel] = "Sim")
		formatString: 0
		displayFolder: 3. Inventário LGPD
		lineageTag: 0b02805d-589c-4cc3-a8ed-6ccdc241ba31

	/// Quantidade de categorias de dados pessoais do inventário (Fase 1).
	measure 'Total Categorias' = COUNTROWS(dim_inventario)
		formatString: 0
		displayFolder: 3. Inventário LGPD
		lineageTag: 7125ba10-a42a-453b-8c2a-68da67ae0f3d

	column dado_id
		dataType: string
		isHidden
