table fato_alertas
	lineageTag: d4f45fcf-d502-4528-bdcd-2cd2d6439a96

	/// Quantidade de alertas detectados nos logs (Fase 2).
	measure 'Total Alertas' = COUNTROWS(fato_alertas)
		formatString: 0
		displayFolder: 2. Alertas
		lineageTag: 66690e03-1687-465b-a625-bd639f1c7872

	/// Alertas iniciados fora do horário comercial ou em fim de semana.
	measure 'Alertas Fora do Expediente' = CALCULATE([Total Alertas], fato_alertas[fora_do_expediente] = "Sim")
		formatString: 0
		displayFolder: 2. Alertas
		lineageTag: 4e9e7b52-1ab9-4dc2-a5cd-d81970fb37c8

	/// Cor semântica da severidade do alerta.
	measure 'Cor da Severidade' = SWITCH(SELECTEDVALUE(fato_alertas[severidade]), "Crítico", "#C0392B", "Alto", "#E67E22", "Médio", "#F1C40F", "Baixo", "#27AE60", "#FFFFFF")
		isHidden
		displayFolder: 9. Auxiliares (formatação)
		lineageTag: 4c8accab-ba17-4134-ae71-78a317680a19

	/// Total de alertas mostrando 0 (em vez de vazio) para riscos sem alerta.
	measure 'Alertas (com zero)' = COALESCE([Total Alertas], 0)
		formatString: 0
		displayFolder: 2. Alertas
		lineageTag: 62aa5cb5-81f6-434c-a474-1f53189d4267

	column alerta_id
		dataType: string
		isHidden
