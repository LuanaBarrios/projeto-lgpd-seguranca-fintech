	partition fato_alertas = m
		mode: import
		source =
				let
				  Origem = Csv.Document(File.Contents(PastaDados & "fato_alertas.csv"), [Delimiter = ",", Columns = 10, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Cabeçalhos promovidos" = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
				  #"Tipo de coluna alterado" = Table.TransformColumnTypes(#"Cabeçalhos promovidos", {{"alerta_id", type text}, {"risco_id", type text}, {"usuario_ou_origem", type text}, {"tipo_origem", type text}, {"inicio", type datetime}, {"data", type date}, {"hora", Int64.Type}, {"fora_do_expediente", type text}, {"severidade", type text}, {"evidencia", type text}})
				in
				  #"Tipo de coluna alterado"

	annotation PBI_ResultType = Table

